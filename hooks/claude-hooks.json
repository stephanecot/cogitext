{
  "$schema": "https://json.schemastore.org/hooks-schema.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "git",
            "args": ["-c", "alias.cogitex=!\"$CLAUDE_PLUGIN_ROOT/dist/.claude/cogitex/cogitex.sh\"", "cogitex", "hook-start", "--claude", "${CLAUDE_PROJECT_DIR}"],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git",
            "args": ["-c", "alias.cogitex=!\"$CLAUDE_PLUGIN_ROOT/dist/.claude/cogitex/cogitex.sh\"", "cogitex", "hook-prompt", "--claude", "${CLAUDE_PROJECT_DIR}"],
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "git",
            "args": ["-c", "alias.cogitex=!\"$CLAUDE_PLUGIN_ROOT/dist/.claude/cogitex/cogitex.sh\"", "cogitex", "hook-guard", "--claude", "${CLAUDE_PROJECT_DIR}"],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
